# Copia este archivo como .env en el servidor y completa cada valor. Nunca lo subas a git.
# Genera los secretos con: openssl rand -base64 32

# Dominio que apunta a la IP elástica del EC2 (registro A en tu DNS)
UKUK_DOMAIN=ukuk.tudominio.pe
# Tu IP pública para usar /admin (ej. 190.12.34.56/32). Por defecto nadie puede.
UKUK_ADMIN_ALLOW=

# Base de datos
POSTGRES_PASSWORD=
UKUK_APP_DB_PASSWORD=

# Secretos de la API. GUARDA UKUK_MASTER_KEY FUERA DEL SERVIDOR: sin ella no se pueden
# descifrar los documentos guardados.
UKUK_MASTER_KEY=
UKUK_LINK_SECRET=
UKUK_ADMIN_TOKEN=

# OCR: tesseract (incluido en la imagen) o textract (rol IAM del EC2 + AWS_REGION)
UKUK_OCR=tesseract
AWS_REGION=

# Opcionales
ANTHROPIC_API_KEY=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
