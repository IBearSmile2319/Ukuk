# Conexión de la app (rol sin privilegios: RLS aplica)
DATABASE_URL=postgres://ukuk_app:ukuk@localhost:5432/ukuk
# Conexión para migraciones (dueño del esquema)
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ukuk
UKUK_ENGINE_URL=http://localhost:8090
# 32 bytes en base64: openssl rand -base64 32
UKUK_MASTER_KEY=
UKUK_LINK_SECRET=
UKUK_ADMIN_TOKEN=
UKUK_PUBLIC_BASE_URL=http://localhost:3000
UKUK_STORAGE_DIR=./var/blobs
UKUK_JOBS_ENABLED=true
# Opcional: explicaciones y resúmenes con Claude
ANTHROPIC_API_KEY=
# Opcional: OCR con Amazon Textract
UKUK_OCR=
AWS_REGION=
# Opcional: WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
# Fuentes de normas (desactivadas hasta tener autorización): el_peruano,sbs
UKUK_REG_SOURCES=
